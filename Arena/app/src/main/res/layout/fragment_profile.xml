<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/spacing_md">

        <!-- Banner Image -->
        <ImageView
            android:id="@+id/img_banner"
            android:layout_width="0dp"
            android:layout_height="@dimen/banner_height"
            android:scaleType="centerCrop"
            android:background="@color/primary_blue_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Banner overlay buttons -->
        <LinearLayout
            android:id="@+id/banner_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_md"
            app:layout_constraintTop_toTopOf="@id/img_banner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/btn_share"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:padding="4dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/text_white"
                android:contentDescription="@string/cd_share" />

            <ImageView
                android:id="@+id/btn_profile_settings"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:padding="4dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_white"
                android:contentDescription="@string/cd_settings" />

            <TextView
                android:id="@+id/btn_edit_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_white"
                android:fontFamily="@font/poppins_medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/edit_profile"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- Avatar -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/img_profile_avatar"
            android:layout_width="@dimen/avatar_large"
            android:layout_height="@dimen/avatar_large"
            android:src="@drawable/bg_avatar_circle"
            app:civ_border_color="@color/card_background"
            app:civ_border_width="4dp"
            app:layout_constraintTop_toBottomOf="@id/img_banner"
            app:layout_constraintBottom_toBottomOf="@id/img_banner"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="@dimen/spacing_lg" />

        <TextView
            android:id="@+id/text_profile_avatar_initial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="G"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintTop_toTopOf="@id/img_profile_avatar"
            app:layout_constraintBottom_toBottomOf="@id/img_profile_avatar"
            app:layout_constraintStart_toStartOf="@id/img_profile_avatar"
            app:layout_constraintEnd_toEndOf="@id/img_profile_avatar" />

        <!-- Stats: POINTS | STREAK -->
        <LinearLayout
            android:id="@+id/layout_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/img_banner"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_points_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="1.2k"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_headline_3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/points_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_streak_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="84"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_headline_3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/streak_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- Username + verified -->
        <LinearLayout
            android:id="@+id/layout_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/img_profile_avatar"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/text_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Gautam"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_headline_2" />

            <ImageView
                android:id="@+id/icon_verified"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_check"
                app:tint="@color/primary_blue" />
        </LinearLayout>

        <!-- Handle -->
        <TextView
            android:id="@+id/text_handle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:fontFamily="@font/poppins_regular"
            android:text="\@ggupta78"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_small"
            app:layout_constraintTop_toBottomOf="@id/layout_username"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_email"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_small"
            app:layout_constraintTop_toBottomOf="@id/text_handle"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bio -->
        <TextView
            android:id="@+id/text_bio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_md"
            android:fontFamily="@font/poppins_regular"
            android:text="Co-Founder - Sevenfold"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_small"
            app:layout_constraintTop_toBottomOf="@id/text_email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Location, Joined, Birthday row -->
        <LinearLayout
            android:id="@+id/layout_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/text_bio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/text_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="📍 Delhi, India"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/text_joined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:fontFamily="@font/poppins_regular"
                android:text="📅 Joined Jan 2026"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:fontFamily="@font/poppins_medium"
                android:text="🔗 Links"
                android:textColor="@color/primary_blue"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- Birthday -->
        <TextView
            android:id="@+id/text_birthday"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_xs"
            android:fontFamily="@font/poppins_regular"
            android:text="🎂 Born June 25, 1996"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            app:layout_constraintTop_toBottomOf="@id/layout_info"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/btn_logout_profile"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_button_outlined"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="@string/logout"
            android:textColor="@color/difficulty_hard"
            android:textSize="@dimen/text_body_small"
            app:layout_constraintTop_toBottomOf="@id/text_birthday"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Recent Activity Header -->
        <TextView
            android:id="@+id/text_recent_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_lg"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/recent_activity"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_headline_3"
            app:layout_constraintTop_toBottomOf="@id/btn_logout_profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/text_activity_filter" />

        <TextView
            android:id="@+id/text_activity_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:fontFamily="@font/poppins_medium"
            android:text="All ↓"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_small"
            app:layout_constraintTop_toTopOf="@id/text_recent_header"
            app:layout_constraintBottom_toBottomOf="@id/text_recent_header"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Recent Activity Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_recent_activity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_sm"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/text_recent_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
