<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141414"
    android:padding="18dp">

    <LinearLayout
        android:id="@+id/layout_duel_top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/avatar_you"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_chip_selected"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="Y"
                android:textColor="@color/text_white"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_player_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:maxLines="1"
                    android:text="You"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/text_player_rating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Logic rating 1459"
                    android:textColor="#8E8E8E"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/text_timer"
            android:layout_width="82dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:text="0:45"
            android:textColor="@color/primary_accent"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_opponent_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="CodeWarrior"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/text_opponent_rating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="end"
                    android:text="Logic rating 1487"
                    android:textColor="#8E8E8E"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/avatar_opponent"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_chip_unselected"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="C"
                android:textColor="@color/primary_accent"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_score_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_duel_top">

        <TextView
            android:id="@+id/text_mcq_score"
            android:layout_width="84dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/text_white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/text_mcq_progress"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginHorizontal="12dp"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="QUESTION 1 / 4"
            android:textColor="#9B9B9B"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/text_opponent_score"
            android:layout_width="84dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/text_white"
            android:textSize="15sp" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_question"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="#1D1D1D"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/layout_options"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_score_row">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="22dp">

            <TextView
                android:id="@+id/text_logic_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:fontFamily="@font/poppins_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="LOGIC MCQ"
                android:textColor="@color/primary_accent"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/text_question"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:lineSpacingMultiplier="1.18"
                android:text="Which data structure is best for constant-time lookup?"
                android:textColor="@color/text_white"
                android:textSize="24sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:text="Choose fast. Accuracy wins the duel."
                android:textColor="#767676"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/layout_options"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_0"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:text="Option 1"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                app:backgroundTint="#303030"
                app:cornerRadius="12dp"
                app:strokeColor="#464646" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:text="Option 2"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                app:backgroundTint="#303030"
                app:cornerRadius="12dp"
                app:strokeColor="#464646" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:text="Option 3"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                app:backgroundTint="#303030"
                app:cornerRadius="12dp"
                app:strokeColor="#464646" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_3"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:text="Option 4"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                app:backgroundTint="#303030"
                app:cornerRadius="12dp"
                app:strokeColor="#464646" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/text_mcq_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="Battle complete. Calculating result..."
        android:textColor="@color/primary_accent"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
