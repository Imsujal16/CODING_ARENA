<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/leaderboard_item_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/background"
    android:paddingHorizontal="16dp">

    <!-- Bottom separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F1F23"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Square Rank Badge with rounded corners -->
    <TextView
        android:id="@+id/text_lb_rank"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_chip_unselected"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="4"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Circular Avatar -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/img_lb_avatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="14dp"
        android:src="@drawable/bg_avatar_circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/text_lb_rank" />

    <TextView
        android:id="@+id/text_lb_avatar_initial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="A"
        android:textColor="@color/text_white"
        android:textSize="@dimen/text_body_small"
        app:layout_constraintBottom_toBottomOf="@id/img_lb_avatar"
        app:layout_constraintEnd_toEndOf="@id/img_lb_avatar"
        app:layout_constraintStart_toStartOf="@id/img_lb_avatar"
        app:layout_constraintTop_toTopOf="@id/img_lb_avatar" />

    <!-- Name + subtitle column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/img_lb_avatar"
        app:layout_constraintEnd_toStartOf="@id/container_score">

        <TextView
            android:id="@+id/text_lb_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Username"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/text_lb_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="1420 - PUZZLE"
            android:textColor="#606068"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Score Pill: neon purple bg for rank 1, plain text for others -->
    <LinearLayout
        android:id="@+id/container_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_unselected"
        android:backgroundTint="#00000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/text_lb_xp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="00:23:84"
            android:textColor="@color/secondary_accent"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
