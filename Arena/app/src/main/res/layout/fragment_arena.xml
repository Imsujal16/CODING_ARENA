<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xxl">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/text_battle_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Arena"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                app:layout_constraintEnd_toStartOf="@id/text_status_pill"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/text_arena_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Pick your duel format and enter the dojo."
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_small"
                app:layout_constraintEnd_toEndOf="@id/text_battle_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_battle_title" />

            <TextView
                android:id="@+id/text_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip_selected"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="DEMO"
                android:textColor="@color/text_white"
                android:textSize="@dimen/text_caption"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/text_battle_title" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_player_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="@dimen/elevation_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/img_user_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/bg_avatar_circle"
                        app:civ_border_color="@color/primary_blue"
                        app:civ_border_width="2dp" />

                    <TextView
                        android:id="@+id/text_user_avatar_letter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:text="P"
                        android:textColor="@color/text_white"
                        android:textSize="@dimen/text_headline_3" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_user_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Player"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title" />

                    <TextView
                        android:id="@+id/text_user_rank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Ready for battle"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badge_user_level"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="LVL"
                    android:textColor="@color/primary_blue"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_developer_battle_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="@dimen/elevation_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Battle server"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            android:id="@+id/text_dev_mode_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Demo uses a bot. Real creates or joins socket rooms."
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_real_battle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_real_join"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bg_card_bordered"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Join private room"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body_small" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Paste your friend's room code to enter the same live battle."
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:hint="Room code"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/primary_blue"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_room_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body_small" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_join_room"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Join Room"
                        android:textAllCaps="false"
                        android:textColor="@color/text_white"
                        app:backgroundTint="@color/primary_blue"
                        app:cornerRadius="@dimen/corner_button" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:fontFamily="@font/poppins_bold"
            android:text="Choose battle type"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup_mode"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:checkedChip="@id/chip_mode_coding"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_mode_coding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Live Coding Battle" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_mode_mcq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MCQ Questions" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mode_coding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="@dimen/elevation_card"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_chip_selected"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:text="{}"
                        android:textColor="@color/text_white"
                        android:textSize="@dimen/text_body" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Live Coding Battle"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Vote on a topic, then solve a real coding challenge."
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_coding_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_chip_selected"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="SELECTED"
                        android:textColor="@color/text_white"
                        android:textSize="@dimen/text_overline" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mode_mcq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="@dimen/elevation_card"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:text="MCQ"
                    android:textColor="@color/primary_blue"
                    android:textSize="@dimen/text_caption" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="MCQ Questions"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Fast logic rounds with instant scoring."
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_mcq_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="TAP"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_overline" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="@dimen/elevation_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Match setup"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Difficulty"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_easy"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/chip_height"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center"
                        android:text="Easy"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body_small" />

                    <TextView
                        android:id="@+id/chip_medium"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/chip_height"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_selected"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center"
                        android:text="Medium"
                        android:textColor="@color/text_white"
                        android:textSize="@dimen/text_body_small" />

                    <TextView
                        android:id="@+id/chip_hard"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/chip_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center"
                        android:text="Hard"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body_small" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Entry coins"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_coin" />

                    <TextView
                        android:id="@+id/text_bet_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="10"
                        android:textColor="@color/coins_orange"
                        android:textSize="@dimen/text_body_small" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_bet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="10"
                    android:value="10"
                    android:valueFrom="10"
                    android:valueTo="100"
                    app:haloColor="@color/coins_orange_light"
                    app:thumbColor="@color/coins_orange"
                    app:trackColorActive="@color/coins_orange"
                    app:trackColorInactive="@color/divider" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fight"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="@dimen/spacing_lg"
            android:fontFamily="@font/poppins_bold"
            android:text="Find Demo Opponent"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="@dimen/text_body"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="@dimen/corner_button" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
