<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/spacing_lg">

        <!-- Toolbar -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:layout_margin="@dimen/spacing_md"
            android:padding="4dp"
            android:contentDescription="@string/cd_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_nav_home" />

        <TextView
            android:id="@+id/text_battle_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/battle_lobby"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            app:layout_constraintTop_toTopOf="@id/btn_back"
            app:layout_constraintBottom_toBottomOf="@id/btn_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:layout_margin="@dimen/spacing_md"
            android:padding="4dp"
            android:contentDescription="@string/cd_settings"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_search" />

        <!-- VS Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_vs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="@dimen/elevation_card"
            app:cardBackgroundColor="@color/card_background"
            app:layout_constraintTop_toBottomOf="@id/btn_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_lg">

                <!-- User side -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/img_user_avatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/bg_avatar_circle"
                    app:civ_border_color="@color/primary_blue"
                    app:civ_border_width="2dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/text_user_avatar_letter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="G"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_headline_3"
                    android:fontFamily="@font/poppins_bold"
                    app:layout_constraintTop_toTopOf="@id/img_user_avatar"
                    app:layout_constraintBottom_toBottomOf="@id/img_user_avatar"
                    app:layout_constraintStart_toStartOf="@id/img_user_avatar"
                    app:layout_constraintEnd_toEndOf="@id/img_user_avatar" />

                <!-- Level badge -->
                <TextView
                    android:id="@+id/badge_user_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:fontFamily="@font/poppins_bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="LVL 42"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_overline"
                    app:layout_constraintTop_toBottomOf="@id/img_user_avatar"
                    app:layout_constraintStart_toStartOf="@id/img_user_avatar"
                    app:layout_constraintEnd_toEndOf="@id/img_user_avatar" />

                <TextView
                    android:id="@+id/text_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Gautam"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_small"
                    app:layout_constraintTop_toBottomOf="@id/badge_user_level"
                    app:layout_constraintStart_toStartOf="@id/img_user_avatar"
                    app:layout_constraintEnd_toEndOf="@id/img_user_avatar" />

                <TextView
                    android:id="@+id/text_user_rank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Grandmaster"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    app:layout_constraintTop_toBottomOf="@id/text_user_name"
                    app:layout_constraintStart_toStartOf="@id/img_user_avatar"
                    app:layout_constraintEnd_toEndOf="@id/img_user_avatar" />

                <!-- VS text -->
                <TextView
                    android:id="@+id/text_vs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/vs"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_headline_3"
                    app:layout_constraintTop_toTopOf="@id/img_user_avatar"
                    app:layout_constraintBottom_toBottomOf="@id/img_user_avatar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Opponent side (searching) -->
                <FrameLayout
                    android:id="@+id/frame_opponent"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ProgressBar
                        android:id="@+id/progress_searching"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/primary_blue" />
                </FrameLayout>

                <TextView
                    android:id="@+id/text_searching"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/searching"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    app:layout_constraintTop_toBottomOf="@id/frame_opponent"
                    app:layout_constraintStart_toStartOf="@id/frame_opponent"
                    app:layout_constraintEnd_toEndOf="@id/frame_opponent" />

                <TextView
                    android:id="@+id/text_searching_rank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/searching_rank"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_overline"
                    app:layout_constraintTop_toBottomOf="@id/text_searching"
                    app:layout_constraintStart_toStartOf="@id/frame_opponent"
                    app:layout_constraintEnd_toEndOf="@id/frame_opponent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Battle Config Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_config"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="@dimen/elevation_card"
            app:cardBackgroundColor="@color/card_background"
            app:layout_constraintTop_toBottomOf="@id/card_vs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/battle_config"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/custom_match"
                        android:textColor="@color/primary_blue"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <!-- Difficulty -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/difficulty"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_easy"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/chip_height"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center"
                        android:text="@string/easy"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body_small" />

                    <TextView
                        android:id="@+id/chip_medium"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/chip_height"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/bg_chip_selected"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center"
                        android:text="@string/medium"
                        android:textColor="@color/text_white"
                        android:textSize="@dimen/text_body_small" />

                    <TextView
                        android:id="@+id/chip_hard"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/chip_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center"
                        android:text="@string/hard"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body_small" />
                </LinearLayout>

                <!-- Topics -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/topics"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:letterSpacing="0.1" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_topics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:singleSelection="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_algorithms"
                        style="@style/Widget.Arena.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/algorithms"
                        android:checked="true"
                        app:chipBackgroundColor="@color/chip_selected_bg"
                        android:textColor="@color/text_white" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_strings"
                        style="@style/Widget.Arena.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/strings_topic" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_dp"
                        style="@style/Widget.Arena.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dynamic_prog" />
                </com.google.android.material.chip.ChipGroup>

                <!-- BET Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/bet"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption"
                        android:letterSpacing="0.1" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_coin" />

                    <TextView
                        android:id="@+id/text_bet_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="500"
                        android:textColor="@color/coins_orange"
                        android:textSize="@dimen/text_body_small" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_bet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="100"
                    android:valueTo="1000"
                    android:value="500"
                    android:stepSize="50"
                    app:thumbColor="@color/coins_orange"
                    app:trackColorActive="@color/coins_orange"
                    app:trackColorInactive="@color/divider"
                    app:haloColor="#33FF8C00" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- FIGHT Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fight"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_lg"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/fight"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="@dimen/text_title"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="@dimen/corner_button"
            app:layout_constraintTop_toBottomOf="@id/card_config"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
