<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Lottie Animation - Centre of screen, slightly above centre -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_splash"
        android:layout_width="280dp"
        android:layout_height="280dp"
        app:lottie_rawRes="@raw/splash_anim"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_speed="1.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/text_arena_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.45" />

    <!-- "A R E N A" wordmark -->
    <TextView
        android:id="@+id/text_arena_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.3"
        android:text="A R E N A"
        android:textColor="@color/white"
        android:textSize="34sp"
        android:alpha="0.0"
        app:layout_constraintTop_toBottomOf="@id/lottie_splash"
        app:layout_constraintBottom_toTopOf="@id/text_tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/text_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Compete. Code. Conquer."
        android:textColor="@color/primary_accent"
        android:textSize="14sp"
        android:letterSpacing="0.08"
        android:alpha="0.0"
        app:layout_constraintTop_toBottomOf="@id/text_arena_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
