<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/spacing_md">

        <!-- Top Bar -->
        <TextView
            android:id="@+id/text_greeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_lg"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/good_morning"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_small"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/img_avatar" />

        <TextView
            android:id="@+id/text_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            style="@style/TextStyle.Headline2"
            android:text="@string/user_name_default"
            app:layout_constraintTop_toBottomOf="@id/text_greeting"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/img_avatar" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/img_avatar"
            android:layout_width="@dimen/avatar_medium"
            android:layout_height="@dimen/avatar_medium"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:src="@drawable/bg_avatar_circle"
            app:civ_border_color="@color/primary_blue"
            app:civ_border_width="2dp"
            app:layout_constraintTop_toTopOf="@id/text_greeting"
            app:layout_constraintBottom_toBottomOf="@id/text_username"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_avatar_initial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="G"
            android:textColor="@color/text_white"
            android:textSize="@dimen/text_headline_3"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintTop_toTopOf="@id/img_avatar"
            app:layout_constraintBottom_toBottomOf="@id/img_avatar"
            app:layout_constraintStart_toStartOf="@id/img_avatar"
            app:layout_constraintEnd_toEndOf="@id/img_avatar" />

        <!-- ══════════ SHIMMER skeleton (shown while data loads) ══════════ -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_lg"
            app:layout_constraintTop_toBottomOf="@id/text_username"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Shimmer row 1 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/shimmer_base"
                    android:backgroundTint="@color/shimmer_base" />

                <!-- Shimmer row 2 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/shimmer_base" />

                <!-- Shimmer row 3 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@color/shimmer_base" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Stats Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="@dimen/elevation_card"
            app:cardBackgroundColor="@color/card_background"
            app:layout_constraintTop_toBottomOf="@id/text_username"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_md">

                <!-- LVL Ring -->
                <FrameLayout
                    android:id="@+id/frame_level"
                    android:layout_width="@dimen/level_ring_size"
                    android:layout_height="@dimen/level_ring_size"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_level_ring" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/lvl_prefix"
                            android:textColor="@color/primary_blue"
                            android:textSize="@dimen/text_overline" />

                        <TextView
                            android:id="@+id/text_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="24"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_headline_3" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Current XP -->
                <TextView
                    android:id="@+id/label_current_xp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/current_xp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    app:layout_constraintTop_toTopOf="@id/frame_level"
                    app:layout_constraintStart_toEndOf="@id/frame_level" />

                <TextView
                    android:id="@+id/text_xp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:fontFamily="@font/poppins_bold"
                    android:text="12,450"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    app:layout_constraintTop_toBottomOf="@id/label_current_xp"
                    app:layout_constraintStart_toEndOf="@id/frame_level" />

                <!-- Rank -->
                <TextView
                    android:id="@+id/label_rank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/rank_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    app:layout_constraintTop_toTopOf="@id/frame_level"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/text_rank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Platinum"
                    android:textColor="@color/primary_blue"
                    android:textSize="@dimen/text_title"
                    app:layout_constraintTop_toBottomOf="@id/label_rank"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Daily Streak -->
                <TextView
                    android:id="@+id/label_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/daily_streak"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/text_xp"
                    app:layout_constraintStart_toEndOf="@id/frame_level"
                    app:layout_constraintBottom_toBottomOf="@id/frame_level" />

                <!-- Streak badge -->
                <LinearLayout
                    android:id="@+id/badge_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_streak_badge"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    app:layout_constraintTop_toBottomOf="@id/text_rank"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/frame_level">

                    <TextView
                        android:id="@+id/text_streak_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="12"
                        android:textColor="@color/coins_orange"
                        android:textSize="@dimen/text_body" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_fire"
                        android:contentDescription="@string/cd_fire" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/days_suffix"
                        android:textColor="@color/coins_orange"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Daily Challenge Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_daily_challenge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="@dimen/elevation_card"
            app:cardBackgroundColor="@color/card_background"
            app:layout_constraintTop_toBottomOf="@id/card_stats"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <!-- Chips row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_difficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_medium"
                        android:fontFamily="@font/poppins_medium"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="@string/medium"
                        android:textColor="@color/difficulty_medium"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/chip_topic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="@font/poppins_medium"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="@string/trees"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/text_xp_reward"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="+50 XP"
                        android:textColor="@color/xp_purple"
                        android:textSize="@dimen/text_body_small" />
                </LinearLayout>

                <!-- Problem title -->
                <TextView
                    android:id="@+id/text_problem_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Binary Tree Maximum Path Sum"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title" />

                <!-- Problem description -->
                <TextView
                    android:id="@+id/text_problem_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Find the maximum path sum in a binary tree where the path may start and end at any node."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_small"
                    android:lineSpacingMultiplier="1.3" />

                <!-- Solve Challenge button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_solve_challenge"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/solve_challenge"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_body"
                    app:backgroundTint="@color/primary_blue"
                    app:cornerRadius="@dimen/corner_button" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Continue Learning Header -->
        <TextView
            android:id="@+id/text_continue_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_lg"
            style="@style/TextStyle.Headline3"
            android:text="@string/continue_learning"
            app:layout_constraintTop_toBottomOf="@id/card_daily_challenge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/text_view_all" />

        <TextView
            android:id="@+id/text_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_md"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/view_all"
            android:textColor="@color/primary_blue"
            android:textSize="@dimen/text_body_small"
            app:layout_constraintTop_toTopOf="@id/text_continue_header"
            app:layout_constraintBottom_toBottomOf="@id/text_continue_header"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Continue Learning Horizontal RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_continue_learning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:clipToPadding="false"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/text_continue_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
