<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_md">

        <!-- Top Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_lg">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/img_learn_avatar"
                android:layout_width="@dimen/avatar_small"
                android:layout_height="@dimen/avatar_small"
                android:src="@drawable/bg_avatar_circle"
                app:civ_border_color="@color/primary_blue"
                app:civ_border_width="1.5dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_learn_welcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_primary"
                android:text="Welcome back, Gautam"
                app:layout_constraintTop_toTopOf="@id/img_learn_avatar"
                app:layout_constraintBottom_toBottomOf="@id/img_learn_avatar"
                app:layout_constraintStart_toEndOf="@id/img_learn_avatar"
                app:layout_constraintEnd_toStartOf="@id/btn_notification" />

            <ImageView
                android:id="@+id/btn_notification"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:src="@drawable/ic_notification"
                android:contentDescription="@string/cd_notification"
                android:padding="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_search" />

            <ImageView
                android:id="@+id/btn_search"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/cd_search"
                android:padding="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Curated Roadmaps Section -->
        <TextView
            android:id="@+id/text_learn_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:padding="@dimen/spacing_md"
            android:text="Loading..."
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_small" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:paddingHorizontal="@dimen/spacing_md">

            <TextView
                android:id="@+id/text_roadmaps_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/curated_roadmaps"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_headline_3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/text_roadmaps_view_all" />

            <TextView
                android:id="@+id/text_roadmaps_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/view_all"
                android:textColor="@color/primary_blue"
                android:textSize="@dimen/text_body_small"
                app:layout_constraintTop_toTopOf="@id/text_roadmaps_header"
                app:layout_constraintBottom_toBottomOf="@id/text_roadmaps_header"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_roadmaps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_md"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Topic Mastery Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:paddingHorizontal="@dimen/spacing_md"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/topic_mastery"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_headline_3" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_topic_mastery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="@dimen/spacing_md"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Up Next Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/up_next"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_headline_3" />

            <TextView
                android:id="@+id/tab_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_selected"
                android:fontFamily="@font/poppins_medium"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="@string/filter_all"
                android:textColor="@color/text_white"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/tab_easy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:background="@drawable/bg_chip_unselected"
                android:fontFamily="@font/poppins_medium"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="@string/filter_easy"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_up_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="@dimen/spacing_md"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
