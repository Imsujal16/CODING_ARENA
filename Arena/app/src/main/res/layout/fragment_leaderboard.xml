<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ====================================================== -->
    <!-- HEADER SECTION: Wave BG + 3D Title                    -->
    <!-- ====================================================== -->
    <FrameLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Wavy background texture -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/leaderboard_wave_bg"
            android:scaleType="centerCrop" />

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btn_lb_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="16dp"
            android:padding="8dp"
            android:background="@drawable/bg_chip_unselected"
            app:srcCompat="@drawable/ic_nav_home"
            app:tint="@color/text_white" />

        <!-- 3D LEADERBOARD title image -->
        <ImageView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:src="@drawable/leaderboard_title_3d" />
    </FrameLayout>

    <!-- ====================================================== -->
    <!-- TABS: FRIENDS | COLLEGE | GLOBAL                       -->
    <!-- ====================================================== -->
    <LinearLayout
        android:id="@+id/layout_tabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/background"
        app:layout_constraintTop_toBottomOf="@id/header_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tab_friends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="FRIENDS"
            android:textColor="#888888"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tab_school"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="COLLEGE"
            android:textColor="#888888"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <!-- Active Tab: GLOBAL with white underline -->
        <LinearLayout
            android:id="@+id/tab_global_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tab_global"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="GLOBAL"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:letterSpacing="0.1" />

            <!-- Active underline -->
            <View
                android:layout_width="50dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:background="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tab Divider -->
    <View
        android:id="@+id/tab_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A2E"
        app:layout_constraintTop_toBottomOf="@id/layout_tabs" />

    <!-- ====================================================== -->
    <!-- BEST TIME Badge (floating right, overlapping divider)  -->
    <!-- ====================================================== -->
    <TextView
        android:id="@+id/badge_best_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_chip_unselected"
        android:backgroundTint="#1C1C1E"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:fontFamily="sans-serif-black"
        android:text="BEST TIME"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/tab_divider"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <!-- ====================================================== -->
    <!-- SHIMMER skeleton while data loads                      -->
    <!-- ====================================================== -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_leaderboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/badge_best_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <View android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginBottom="8dp" android:background="@color/shimmer_base"/>
            <View android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginBottom="8dp" android:background="@color/shimmer_base"/>
            <View android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginBottom="8dp" android:background="@color/shimmer_base"/>
            <View android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginBottom="8dp" android:background="@color/shimmer_base"/>
            <View android:layout_width="match_parent" android:layout_height="56dp"
                android:background="@color/shimmer_base"/>

            <TextView
                android:id="@+id/text_loading_ranks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:text="Loading ranks..."
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_small" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- ====================================================== -->
    <!-- LEADERBOARD LIST (rank 1 onwards, all in one list)    -->
    <!-- ====================================================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_leaderboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/shimmer_leaderboard"
        app:layout_constraintBottom_toTopOf="@id/bottom_action_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ====================================================== -->
    <!-- BOTTOM ACTION BAR: VIEW SOLUTION | PLAY MORE          -->
    <!-- ====================================================== -->
    <LinearLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/background"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:id="@+id/btn_view_solution"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-black"
            android:text="VIEW SOLUTION"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            app:strokeColor="#555555"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:id="@+id/btn_play_more"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-black"
            android:text="PLAY MORE"
            android:textColor="@color/secondary_accent"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            app:strokeColor="@color/secondary_accent"
            app:cornerRadius="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
